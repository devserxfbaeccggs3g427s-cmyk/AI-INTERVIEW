# ── Local ────────────────────────────────────────────────
# SQLite file nằm cạnh schema.prisma
DATABASE_URL="file:./dev.db"

# ── Anthropic (cloud) ────────────────────────────────────
# Copy file này thành `.env.local` rồi điền key thật.
# `.env` và `.env.local` đều bị `.gitignore` chặn — KHÔNG BAO GIỜ commit.
# Nếu để trống, app chạy chế độ offline: task `local` dùng Ollama,
# task `anthropic` fallback sang rule cục bộ.
ANTHROPIC_API_KEY=""

# ── Ollama (local provider) ─────────────────────────────
# Địa chỉ server Ollama trên máy. Mặc định localhost.
OLLAMA_BASE_URL="http://localhost:11434"
# Model local dùng cho task `local` — xem design.md §6.1
OLLAMA_MODEL_DEFAULT="qwen2.5:7b"
