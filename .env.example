# InterviewAI Studio environment

# Where the server-side SQLite file lives. Default: ./data/interview_sessions.db
# The directory is created automatically if missing.
INTERVIEW_DB_PATH=./data/interview_sessions.db

# Enable only these AI providers across the picker and API (comma-separated).
# Defaults to anthropic,openai,gemini when unset. Add custom explicitly to enable it.
# NEXT_PUBLIC_* is embedded at build time: restart next dev or rebuild for production.
# NEXT_PUBLIC_PROVIDER_ENABLE=anthropic,openai,gemini,custom

# Set to 1 to allow custom-provider URLs pointing at private IPs / loopback.
# Required for local Ollama/LM Studio (http://localhost:11434 or .../v1).
# Link-local/metadata IPs remain blocked. Never expose an unauthenticated instance publicly;
# custom BYOK keys are sent to the selected URL. In production / VPS leave this 0.
ALLOW_PRIVATE_BASE_URL=0

# Exact browser Origin allowed to call POST/DELETE API routes. Server-only runtime value;
# never use NEXT_PUBLIC_BASE_URL or request Host/X-Forwarded-* as a substitute.
# Set to the HTTPS origin on the VPS (scheme + host + optional port, no trailing /).
# For local development set explicitly to http://localhost:3000 (or your actual origin).
# Missing/invalid PUBLIC_ORIGIN rejects mutation requests; there is no CSRF bypass.
# PUBLIC_ORIGIN=https://interview.example.com

# Single switch to disable origin enforcement across every API route.
# Set to 1 to bypass; any value other than 1/true leaves the check enforced.
# Only intended for local development / testing — never enable on a public host.
DISABLE_ORIGIN_CHECK=0

# Public base URL (optional, only needed for OAuth / external links).
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
