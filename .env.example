# ── Database ───────────────────────────────────────────────────────────────
# SQLite local — không cần DB server (P5: cục bộ trước).
# Đường dẫn tương đối so với thư mục `prisma/` — file thực tế: prisma/dev.db
DATABASE_URL="file:./dev.db"

# ── Anthropic API ──────────────────────────────────────────────────────────
# TUYỌN CHỌN. Bỏ trống → app chạy OFFLINE MODE (mọi tính năng AI hiện
# "cần API key" thay vì crash). Lấy key tại https://console.anthropic.com/
#
#   ANTHROPIC_API_KEY=sk-ant-...
#
# File .env.local KHÔNG được commit (đã có trong .gitignore).
ANTHROPIC_API_KEY=
