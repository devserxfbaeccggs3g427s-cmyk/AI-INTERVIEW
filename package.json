{
  "name": "daily-loop-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx scripts/prisma-cli.ts generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev --name init --skip-generate --skip-seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/prisma-cli.ts migrate reset --force --skip-generate && npm run db:seed",
    "db:studio": "tsx scripts/prisma-cli.ts studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "validate:specs": "python3 .kiro/scripts/validate_specs.py",
    "progress": "python3 .kiro/scripts/roadmap_progress.py",
    "db:migrate:deploy": "tsx scripts/prisma-cli.ts migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.19.0",
    "next": "^15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.28",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2",
    "tinypool": "^2.2.0"
  },
  "overridesComment": {
    "minimatch": "Advisory GHSA-g3hv-75wg-m249 (DoS qua globparts) yêu cầu minimatch>=11.0.1 (ESM-only). ESLint 9.39.5 + @eslint/config-array + @eslint/eslintrc cần minimatch@^3 (CJS, default export) => nâng cưỡng ép làm ESLint hỏng ('does not provide an export named default'). ESLint 10 dùng minimatch@^10.2.4 nhưng eslint-config-next@15.5.28 và eslint-plugin-react@7.37.5 chỉ hỗ trợ peer eslint <=9. => giữ nguyên: `npm audit --omit=dev` = 0 vulnerability (advisory chỉ nằm trong dev tooling, không vào runtime app). Sẽ nâng khi eslint-config-next hỗ trợ ESLint 10."
  }
}
