// Prisma schema — Daily Loop OS
//
// Nguồn chân lý: `system-design/SPEC.md` §4 (19 model).
// Feature này (app-foundation) chỉ khởi tạo đúng 19 model gốc.
//
// ⚠️ Registry `.kiro/steering/data-model-registry.md` khai báo thêm 34 field (C1–C34)
// và 11 model (M1–M11) — những thay đổi đó do feature tương ứng tự migration,
// KHÔNG đưa vào đây (giữ nguyên ranh giới Phase -1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Cây kỹ năng ────────────────────────────────────────────────────────────
model Skill {
  id          String   @id @default(cuid())
  name        String
  nameZh      String? // tên tiếng Trung cho kỹ năng ngôn ngữ
  domain      String // professional | communication | language | personal
  parentId    String?
  parent      Skill?   @relation("SkillTree", fields: [parentId], references: [id])
  children    Skill[]  @relation("SkillTree")
  level       Int      @default(0) // 0..5, chỉ tăng qua Evidence (quy tắc B1)
  targetLevel Int      @default(3)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  activities  Activity[]
  evidences   Evidence[]
}

// ── Hoạt động (bảng trung tâm, domain-agnostic) ───────────────────────────
model Activity {
  id         String   @id @default(cuid())
  skillId    String?
  skill      Skill?   @relation(fields: [skillId], references: [id])
  domain     String
  type       String // study|write|speak|roleplay|srs|journal|health|custom|mock_interview|test
  minutes    Int      @default(0)
  title      String
  content    String?
  quality    Int? // 1..5 tự đánh giá
  aiScore    Float? // điểm AI nếu có (rubric trung bình)
  createdAt  DateTime @default(now())
  evidences  Evidence[]
  reflection Reflection?
  // Quan hệ ngược 1-1 (SPEC §4 `InterviewSession.activity` / `TestSession.activity`).
  interviewSession InterviewSession?
  testSession     TestSession?
}

// ── Bằng chứng (P3: tiến độ = bằng chứng) ─────────────────────────────────
model Evidence {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rating     Int // 1..4 chất lượng bằng chứng
  createdAt  DateTime @default(now())

  @@index([skillId])
}

// ── Nhật ký & phản hồi AI ─────────────────────────────────────────────────
model Reflection {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  prompt     String
  answer     String
  aiFeedback String?
  createdAt  DateTime @default(now())
}

// ── Kế hoạch ngày ─────────────────────────────────────────────────────────
model PlanItem {
  id        String   @id @default(cuid())
  date      DateTime @default(now()) // chuẩn hoá 00:00 local
  slot      Int // 0..5
  domain    String
  action    String
  detail    String?
  minutes   Int      @default(15)
  skillId   String?
  done      Boolean  @default(false)
  source    String   @default("ai") // ai | manual | fallback
  createdAt DateTime @default(now())

  @@index([date])
}

// ── SRS ────────────────────────────────────────────────────────────────────
model Card {
  id             String   @id @default(cuid())
  lang           String // zh | en
  front          String // zh: pinyin · en: word
  frontAlt       String? // zh: hanzi
  back           String // nghĩa
  note           String?
  example        String?
  examplePinyin  String?
  hint           String? // phiên âm gợi ý kiểu Việt (chỉ dùng 2 tuần đầu)
  group          String? // nhóm chủ đề
  mode           String   @default("recognize") // recognize|recall|produce
  cardState      Json // state FSRS
  due            DateTime
  stability      Float    @default(0)
  difficulty     Float    @default(0)
  reps           Int      @default(0)
  lapses         Int      @default(0)
  createdAt      DateTime @default(now())
  reviews        Review[]

  @@index([lang, due])
}

model Review {
  id     String   @id @default(cuid())
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating Int // 1=Again 2=Hard 3=Good 4=Easy
  state  Json
  at     DateTime @default(now())
}

// ── Chỉ số cá nhân ────────────────────────────────────────────────────────
model DailyState {
  id        String   @id @default(cuid())
  date      DateTime @unique
  mood      Int?
  energy    Int?
  sleep     Float?
  focus     Int?
  note      String?
  updatedAt DateTime @updatedAt
}

// ── Hồ sơ ─────────────────────────────────────────────────────────────────
model UserProfile {
  id            String   @id @default(cuid())
  name          String?
  goals         String?
  aiTone        String   @default("direct") // direct|coach|gentle
  learningLangs String   @default("zh,en")
  zhLevel       String   @default("zero")
  enLevel       String   @default("zero")
  // Registry C3 — trọng tâm hôm nay (FK logic tới Skill.id).
  focusSkillId  String?
  createdAt     DateTime @default(now())
}

// ── Theo dõi chi phí AI ───────────────────────────────────────────────────
model AiCall {
  id            String   @id @default(cuid())
  feature       String // daily_plan|grading|journal_feedback|weekly_review|classify|roleplay|mock_interview|language_test
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  cacheRead     Int      @default(0)
  cacheWrite    Int      @default(0)
  estimatedCost Float    @default(0)
  ok            Boolean  @default(true)
  error         String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ── Mock Interview ────────────────────────────────────────────────────────
model InterviewProfile {
  id            String   @id @default(cuid())
  label         String // "Backend Engineer"
  jobTitle      String
  seniority     String   @default("mid") // junior|mid|senior|lead
  language      String   @default("en") // en|vi
  questionKinds String   @default("concept,design") // concept|design|debug|tradeoff|behavioral
  focusSkills   String   @default("[]") // JSON: [skillId]
  createdAt     DateTime @default(now())
  sessions      InterviewSession[]
}

model InterviewSession {
  id            String   @id @default(cuid())
  profileId     String
  profile       InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plannedCount  Int      @default(8)
  askedCount    Int      @default(0)
  status        String   @default("active") // active|done|abandoned
  totalScore    Float?
  skillsFocused String   @default("[]") // JSON: [skillId]
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  turns         InterviewTurn[]
  // Registry C28 — khoá 1-1 với Activity.
  activityId    String?      @unique
  activity      Activity?    @relation(fields: [activityId], references: [id])
}

model InterviewTurn {
  id           String   @id @default(cuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index        Int
  question     String
  kind         String // concept|design|debug|tradeoff|behavioral
  skillName    String?
  answer       String?
  scores       Json? // {clarity:[score,note], depth:[...], reasoning:[...], communication:[...], tradeoff:[...]}
  total        Float?
  feedback     String?
  nextQuestion String?
  createdAt    DateTime @default(now())
}

// ── Bài kiểm tra ngoại ngữ ────────────────────────────────────────────────
model TestSession {
  id          String   @id @default(cuid())
  lang        String // zh|en
  testType    String // placement|topic|benchmark|from_content
  topic       String?
  level       String? // level ước lượng sau bài
  score       Float?
  maxScore    Float?
  durationSec Int?
  blueprint   Json? // {itemTypes:[...], count:n}
  createdAt   DateTime @default(now())
  items       TestItem[]
  // Khoá 1-1 với Activity — cần khóa unique để Prisma validate được.
  activityId  String?    @unique
  activity    Activity?  @relation(fields: [activityId], references: [id])
}

model TestItem {
  id          String   @id @default(cuid())
  testId      String
  test        TestSession @relation(fields: [testId], references: [id], onDelete: Cascade)
  index       Int
  itemType    String // mc_vocab|mc_grammar|cloze|listening|writing|translation
  prompt      String
  audioText   String? // cho item listening: text để TTS đọc
  options     Json? // ["a","b","c","d"]
  answer      String? // đáp án đúng (objective)
  userAnswer  String?
  isCorrect   Boolean?
  cardId      String? // thẻ SRS liên quan → nếu sai thì đẩy về ôn
  skillName   String?
  errorGroups Json? // writing/translation: {grammar:[],vocab:[],expression:[],context:[]}
  notes       String?
  seconds     Int?
}
