// Prisma schema — Daily Loop OS
//
// Nguồn chân lý: `system-design/SPEC.md` §4 (19 model).
// Feature này (app-foundation) chỉ khởi tạo đúng 19 model gốc.
//
// ⚠️ Registry `.kiro/steering/data-model-registry.md` khai báo thêm 34 field (C1–C34)
// và 11 model (M1–M11) — những thay đổi đó do feature tương ứng tự migration,
// KHÔNG đưa vào đây (giữ nguyên ranh giới Phase -1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Cây kỹ năng ────────────────────────────────────────────────────────────
model Skill {
  id          String   @id @default(cuid())
  name        String
  nameZh      String? // tên tiếng Trung cho kỹ năng ngôn ngữ
  domain      String // professional | communication | language | personal
  parentId    String?
  parent      Skill?   @relation("SkillTree", fields: [parentId], references: [id])
  children    Skill[]  @relation("SkillTree")
  level       Int      @default(0) // 0..5, chỉ tăng qua Evidence (quy tắc B1)
  targetLevel Int      @default(3)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  activities  Activity[]
  evidences   Evidence[]
}

// ── Hoạt động (bảng trung tâm, domain-agnostic) ───────────────────────────
model Activity {
  id         String   @id @default(cuid())
  skillId    String?
  skill      Skill?   @relation(fields: [skillId], references: [id])
  domain     String
  type       String // study|write|speak|roleplay|srs|journal|health|custom|mock_interview|test
  minutes    Int      @default(0)
  title      String
  content    String?
  quality    Int? // 1..5 tự đánh giá
  aiScore    Float? // điểm AI nếu có (rubric trung bình)
  language   String? // en|zh|vi — hoạt động ngoại ngữ (Registry C34)
  createdAt  DateTime @default(now())
  evidences  Evidence[]
  reflection Reflection?
  // Quan hệ ngược 1-1 (SPEC §4 `InterviewSession.activity` / `TestSession.activity`).
  interviewSession InterviewSession?
  testSession     TestSession?
  // Quan hệ ngược 1-1 — communication-training (registry §3 M3/M4/M6/M8).
  speakAttempt    SpeakAttempt?
  roleplaySession RoleplaySession?
  languagePractice LanguagePractice?

  // Báo cáo tiến bộ cần quét theo mốc thời gian (90 ngày × 4 domain).
  @@index([createdAt])
}

// ── Bằng chứng (P3: tiến độ = bằng chứng) ─────────────────────────────────
model Evidence {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rating     Int // 1..4 chất lượng bằng chứng
  createdAt  DateTime @default(now())

  @@index([skillId])
  // Báo cáo tiến bộ quét evidence theo mốc thời gian (90 ngày).
  @@index([createdAt])
}

// ── Nhật ký & phản hồi AI ─────────────────────────────────────────────────
/// Nhật ký cá nhân + phản hồi AI (C4–C10).
///
/// ⚠️ `activityId` **nullable** (C4): bản nháp (`status = "draft"`) tồn tại
/// mà chưa tạo `Activity` — P3: nhật ký chỉ thành hoạt động khi commit.
model Reflection {
  id         String   @id @default(cuid())
  activityId String?  @unique
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  /// Câu hỏi gợi ý / prompt đã dùng.
  prompt     String
  /// Nội dung người dùng viết.
  answer     String
  /// JSON `{ summary, sharpQuestion }` — phản hồi AI-05.
  aiFeedback String?
  /// C5: `draft | published`. Bản nháp không tính vào thống kê.
  status     String   @default("published")
  /// C6: domain do AI-06 hoặc rule cục bộ gán.
  classifiedDomain String?
  /// C7: skill được gán — đã kiểm chứng tồn tại trong DB.
  classifiedSkillId String?
  /// C8: 0–1.
  classificationConfidence Float?
  /// C9: mốc so sánh bản nháp mới/cũ.
  draftUpdatedAt DateTime?
  /// C10: nhận biết phản hồi AI đã lỗi thời sau khi sửa.
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([classifiedDomain])
}

// ── Kế hoạch ngày ─────────────────────────────────────────────────────────
model PlanItem {
  id        String   @id @default(cuid())
  date      DateTime @default(now()) // chuẩn hoá 00:00 local
  slot      Int // 0..5
  domain    String
  action    String
  detail    String?
  minutes   Int      @default(15)
  skillId   String?
  done      Boolean  @default(false)
  source    String   @default("ai") // ai | manual | fallback
  createdAt DateTime @default(now())

  @@index([date])
  // Báo cáo tuần cần đếm slot theo ngày + trạng thái hoàn thành.
  @@index([date, done])
}

// ── SRS ────────────────────────────────────────────────────────────────────
model Card {
  id             String   @id @default(cuid())
  lang           String // zh | en
  front          String // zh: pinyin · en: word
  frontAlt       String? // zh: hanzi
  back           String // nghĩa
  note           String?
  example        String?
  examplePinyin  String?
  hint           String? // phiên âm gợi ý kiểu Việt (chỉ dùng 2 tuần đầu)
  group          String? // nhóm chủ đề
  mode           String   @default("recognize") // recognize|recall|produce
  cardState      Json // state FSRS
  due            DateTime
  stability      Float    @default(0)
  difficulty     Float    @default(0)
  reps           Int      @default(0)
  lapses         Int      @default(0)
  createdAt      DateTime @default(now())
  reviews        Review[]

  @@index([lang, due])
}

model Review {
  id     String   @id @default(cuid())
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating Int // 1=Again 2=Hard 3=Good 4=Easy
  state  Json
  at     DateTime @default(now())
  /// Registry C27 — `srs` (lượt ôn thường) | `test` (lượt do bài kiểm tra đẩy về).
  source String   @default("srs")
}

// ── Chỉ số cá nhân ────────────────────────────────────────────────────────
model DailyState {
  id        String   @id @default(cuid())
  date      DateTime @unique
  mood      Int?
  energy    Int?
  sleep     Float?
  focus     Int?
  note      String?
  updatedAt DateTime @updatedAt
}

// ── Hồ sơ ─────────────────────────────────────────────────────────────────
model UserProfile {
  id            String   @id @default(cuid())
  name          String?
  /// FR-SC-02 — mục tiêu dài hạn + M11 — mục tiêu sắp tới (JSON).
  goals         String?
  aiTone        String   @default("direct") // direct|coach|gentle
  learningLangs String   @default("zh,en")
  zhLevel       String   @default("zero")
  enLevel       String   @default("zero")
  /// C29 — tiếng Việt là bản ngữ (AI biết không cần dạy ngữ pháp vi).
  viLevel       String   @default("B2")
  /// C32 — chuẩn hiển thị ưu tiên: cefr | hsk | both.
  languageStandard String @default("cefr")
  /// C14 — ngôn ngữ phỏng vấn mặc định.
  interviewLang String   @default("en")
  /// C15 — ngân sách chi phí AI tháng (USD).
  monthlyBudgetUsd Float @default(15)
  /// C16 — chế độ khẩn cấp tiết kiệm: ép mọi call AI về Haiku.
  saverMode     Boolean  @default(false)
  // Registry C3 — trọng tâm hôm nay (FK logic tới Skill.id).
  focusSkillId  String?
  createdAt     DateTime @default(now())
}

// ── Theo dõi chi phí AI ───────────────────────────────────────────────────
/// Nhật ký lời gọi AI — cơ sở của panel minh bạch "Dữ liệu đã gửi lên".
model AiCall {
  id            String   @id @default(cuid())
  feature       String // daily_plan|grading|journal_feedback|weekly_review|classify|roleplay|mock_interview|language_test
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  cacheRead     Int      @default(0)
  cacheWrite    Int      @default(0)
  estimatedCost Float    @default(0)
  ok            Boolean  @default(true)
  error         String?
  /// C13: trích nội dung **đã gửi lên** (≤160 ký tự cho nhật ký).
  dataPreview   String?
  /// C11: trỏ tới `Reflection`/`Activity` đã gửi lên.
  sourceId      String?
  /// C12: phân loại dữ liệu đã gửi lên (JSON array).
  dataKinds     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ── Mock Interview ────────────────────────────────────────────────────────
model InterviewProfile {
  id            String   @id @default(cuid())
  label         String // "Backend Engineer"
  jobTitle      String
  seniority     String   @default("mid") // junior|mid|senior|lead
  language      String   @default("en") // en|vi
  questionKinds String   @default("concept,design") // concept|design|debug|tradeoff|behavioral
  focusSkills   String   @default("[]") // JSON: [skillId]
  /// C35 — FR-MI-07: phương thức trả lời `text | voice`.
  answerMode    String   @default("text")
  /// C36 — FR-MI-14: chấm thêm điểm "clarity of expression".
  englishClarity Boolean @default(false)
  createdAt     DateTime @default(now())
  sessions      InterviewSession[]
}

model InterviewSession {
  id            String   @id @default(cuid())
  profileId     String
  profile       InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plannedCount  Int      @default(8)
  askedCount    Int      @default(0)
  status        String   @default("active") // active|paused|done|abandoned
  totalScore    Float?
  skillsFocused String   @default("[]") // JSON: [skillId]
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  turns         InterviewTurn[]
  // Registry C28 — khoá 1-1 với Activity.
  activityId    String?      @unique
  activity      Activity?    @relation(fields: [activityId], references: [id])
  /// C37 — kết quả AI-13 đã chuẩn hoá (3 mạnh / 3 yếu / đề xuất).
  report        Json?
  /// C38 — 5 dạng câu của phiên này (CSV).
  questionKinds String   @default("concept,design")
  /// C39 — phương thức trả lời của phiên này.
  answerMode    String   @default("text")
  /// C40 — cờ đo tiếng Anh của phiên này.
  englishClarity Boolean @default(false)
  /// C41 — Adaptive Loop (FR-MI-06).
  adaptive      Boolean  @default(true)
  /// C30 — loại phiên: skill_drill | interview_loop | partner_sim.
  sessionType   String   @default("interview_loop")
  /// C31 — vì sao phiên này được đề xuất.
  focusHint     String?

  @@index([profileId, status, startedAt])
}

model InterviewTurn {
  id           String   @id @default(cuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index        Int
  question     String
  kind         String // concept|design|debug|tradeoff|behavioral
  skillName    String?
  answer       String?
  scores       Json? // {accuracy:[score,note], depth:[...], reasoning:[...], communication:[...], tradeoff:[...]}
  total        Float?
  feedback     String?
  nextQuestion String?
  createdAt    DateTime @default(now())
  /// C42 — node kỹ năng câu hỏi nhắm tới.
  skillId        String?
  /// C43 — rubric hành vi 4 tiêu chí (câu `behavioral`).
  behavioralScores Json?
  /// C44 — điểm "clarity of expression" (FR-MI-14).
  clarityScore   Float?
  /// C45 — dạng của câu kế tiếp.
  nextKind       String?
  /// C46 — node của câu kế tiếp.
  nextSkillId    String?
  /// C47 — câu này là follow-up của câu trước.
  isFollowUp     Boolean  @default(false)
  /// C48 — lý do AI chọn câu này.
  adaptiveReason String?
  /// C49 — người dùng đánh dấu câu hỏi có vấn đề.
  flagged        Boolean  @default(false)
  /// C50 — lý do ngắn kèm cờ.
  flagReason     String?

  @@index([sessionId, index])
}

// ── Bài kiểm tra ngoại ngữ ────────────────────────────────────────────────
model TestSession {
  id          String   @id @default(cuid())
  lang        String // zh|en
  testType    String // placement|topic|benchmark|from_content
  topic       String?
  level       String? // level ước lượng sau bài
  score       Float?
  maxScore    Float?
  durationSec Int?
  blueprint   Json? // {itemTypes:[...], count:n}
  createdAt   DateTime @default(now())
  items       TestItem[]
  // Khoá 1-1 với Activity — cần khóa unique để Prisma validate được.
  activityId  String?    @unique
  activity    Activity?  @relation(fields: [activityId], references: [id])
  /// Registry C17 — `active` | `done` | `abandoned` | `expired`.
  status      String     @default("active")
  /// Registry C18 — hash parallel form (FR-LT-12).
  formSignature String?
  /// Registry C19 — `ai` | `local`: nguồn của level ước lượng.
  levelSource String     @default("local")
  /// Registry C20 — văn bản người dùng dán cho `from_content`.
  sourceText  String?
  /// Registry C21 — tách khỏi `createdAt` để đo thời gian làm bài.
  startedAt   DateTime   @default(now())
  /// Registry C22 — thời điểm nộp bài.
  endedAt     DateTime?
  /// Registry C33 — chuẩn của đề này: `cefr` | `hsk` | `vendor`.
  standard    String     @default("cefr")

  @@index([lang, status])
}

model TestItem {
  id          String   @id @default(cuid())
  testId      String
  test        TestSession @relation(fields: [testId], references: [id], onDelete: Cascade)
  index       Int
  itemType    String // mc_vocab|mc_grammar|cloze|listening|writing|translation
  prompt      String
  audioText   String? // cho item listening: text để TTS đọc
  options     Json? // ["a","b","c","d"]
  answer      String? // đáp án đúng (objective)
  userAnswer  String?
  isCorrect   Boolean?
  cardId      String? // thẻ SRS liên quan → nếu sai thì đẩy về ôn
  skillName   String?
  errorGroups Json? // writing/translation: {grammar:[],vocab:[],expression:[],context:[]}
  notes       String?
  seconds     Int?
  /// Registry C23 — giải thích ngắn cho câu đúng (hoặc khi AI chưa kịp chấm).
  explanation String?
  /// Registry C24 — đánh dấu cờ (FR-LT-17).
  flagged     Boolean @default(false)
  /// Registry C25 — điểm 4 nhóm lỗi: {grammar, vocab, expression, context}.
  rubric      Json?
  /// Registry C26 — đã chấm xong (câu tự luận chờ AI → `false`).
  scored      Boolean @default(false)

  @@unique([testId, index])
}

// ── Communication Training (communication-training, registry §3) ────────────

model SpeakPrompt {
  id         String   @id @default(cuid())
  code       String   @unique          // EX-01..EX-12 | CUS-xxxx
  title      String
  prompt     String
  level      String                   // A1|A2|B1|B2|C1
  lang       String                   // en|vi|zh
  mode       String   @default("both") // write|speak|both
  tags       String   @default("[]")   // JSON string[]
  isUserMade Boolean  @default(false)
  createdAt  DateTime @default(now())
  attempts   SpeakAttempt[]

  @@index([level, lang, mode])
}

model SpeakAttempt {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  promptId   String?
  prompt     SpeakPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  mode       String                   // write|speak
  content    String                   // bài viết hoặc transcript
  rubric     Json                     // {clarity:{score,comment,fix}, ...}
  totalScore Float
  delta      Json?                    // {total, criteria:{key:number}}
  speechMeta Json?                    // {durationSec,wordsPerMinute,fillerWords,pauses}
  createdAt  DateTime @default(now())

  @@index([mode, createdAt])
}

model RoleplayScenario {
  id          String   @id @default(cuid())
  code        String   @unique          // SP-01..SP-15
  title       String
  brief       String
  hiddenGoal  String?                  // FR-CM-06 — không gửi cho AI ở task next_turn
  lang        String   @default("en")
  level       String
  durationSec Int      @default(60)
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  sessions    RoleplaySession[]
}

model RoleplaySession {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    RoleplayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  status      String   @default("active")   // active|done|abandoned
  goalScore   Int?                          // 0..5
  goalNote    String?
  transcript  Json     @default("[]")       // [{index,role,text}]
  activityId  String? @unique
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  turns       RoleplayTurn[]

  @@index([status, startedAt])
}

model RoleplayTurn {
  id        String   @id @default(cuid())
  sessionId String
  session   RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index     Int
  speaker   String                 // ai|user
  text      String
  createdAt DateTime @default(now())

  @@index([sessionId, index])
}

model LanguagePractice {
  id          String   @id @default(cuid())
  activityId  String   @unique
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lang        String   // zh|en
  level       String
  prompt      String
  input       String
  corrected   String?
  errorGroups Json     // {grammar:[…],vocab:[…],expression:[…],context:[…]}
  keywords    Json     @default("[]")
  score       Float?
  createdAt   DateTime @default(now())
  cards       PracticeCard[]
}

model PracticeCard {
  id         String   @id @default(cuid())
  practiceId String
  practice   LanguagePractice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  cardId     String?          // null = chưa đẩy vào deck FSRS
  front      String
  back       String
  note       String?
  example    String?
  createdAt  DateTime @default(now())

  @@index([practiceId])
}
